# Uruchamiaj z katalogu głównego projektu: doxygen doxygen/Doxyfile
PROJECT_NAME           = "Silnik 2D"
PROJECT_BRIEF          = "Dokumentacja techniczna silnika 2D"
OUTPUT_LANGUAGE        = Polish
OUTPUT_DIRECTORY       = doxygen

INPUT                  = src
FILE_PATTERNS          = *.hpp *.cpp
RECURSIVE              = YES
STRIP_FROM_PATH        = src
EXTRACT_ALL            = NO
EXTRACT_PRIVATE        = NO
SOURCE_BROWSER         = YES
INLINE_SOURCES         = NO

GENERATE_HTML          = YES
HTML_OUTPUT            = html
GENERATE_TREEVIEW      = YES
GENERATE_LATEX         = NO
GENERATE_XML           = NO
HAVE_DOT               = NO

QUIET                  = YES
WARN_IF_UNDOCUMENTED   = NO
WARN_IF_DOC_ERROR      = YES
WARN_AS_ERROR          = YES
