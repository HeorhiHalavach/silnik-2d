// Zadania dostępne przez Ctrl+Shift+P → "task: spawn".
// Korzystają ze skryptów zdefiniowanych w devenv.nix.
[
  {
    "label": "Zbuduj",
    "command": "build",
    "cwd": "$ZED_WORKTREE_ROOT",
    "reveal": "no_focus"
  },
  {
    "label": "Uruchom",
    "command": "run",
    "cwd": "$ZED_WORKTREE_ROOT",
    "reveal": "always"
  },
  {
    "label": "Dokumentacja (Doxygen)",
    "command": "docs",
    "cwd": "$ZED_WORKTREE_ROOT",
    "reveal": "no_focus"
  },
  {
    "label": "Wyczyść build",
    "command": "clean",
    "cwd": "$ZED_WORKTREE_ROOT",
    "reveal": "never"
  }
]
